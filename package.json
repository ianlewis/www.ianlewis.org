{
  "prettier": {
    "plugins": [
      "@shopify/prettier-plugin-liquid"
    ],
    "overrides": [
      {
        "files": "**/*.html",
        "options": {
          "parser": "liquid-html"
        }
      }
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@csstools/stylelint-formatter-github": "2.0.0",
    "@netlify/plugin-csp-nonce": "1.6.2",
    "@shopify/prettier-plugin-liquid": "1.11.0",
    "dictionary-en": "4.0.0",
    "encoding": "0.1.13",
    "eslint": "10.9.1",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-prettier": "5.5.6",
    "html-validate": "11.10.0",
    "markdownlint-cli2": "0.23.2",
    "netlify-cli": "27.4.1",
    "picomatch": "4.0.7",
    "prettier": "3.9.6",
    "renovate": "44.52.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.2.0",
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-spelling": "0.3.0"
  }
}
